# Copy to .env and adjust. Every setting has a default; see src/generation_eval/config.py.

# LLM judge (RAGAS, DeepEval and the custom judge), served by Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
JUDGE_MODEL=qwen2.5:1.5b
RAGAS_EMBEDDING_MODEL=all-minilm
INCLUDE_REASONS=false

# Semantic similarity
SENTENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Default framework per LLM-judged metric: ragas | deepeval | custom
FAITHFULNESS_ENGINE=ragas
ANSWER_RELEVANCY_ENGINE=ragas
ANSWER_CORRECTNESS_ENGINE=ragas
ANSWER_COMPLETENESS_ENGINE=deepeval

# Pass thresholds (0-1)
THRESHOLD_FAITHFULNESS=0.8
THRESHOLD_ANSWER_RELEVANCY=0.7
THRESHOLD_ANSWER_CORRECTNESS=0.7
THRESHOLD_ANSWER_COMPLETENESS=0.8
THRESHOLD_SEMANTIC_SIMILARITY=0.8
THRESHOLD_EXACT_MATCH=1.0
THRESHOLD_BLEU=0.3
THRESHOLD_ROUGE=0.5

# Langfuse tracking: create a project at http://localhost:3000, then Settings > API Keys
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
